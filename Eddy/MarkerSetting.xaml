<Window x:Class="Eddy.MarkerSetting"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Eddy"
        mc:Ignorable="d"
        Title="Window1" 
        ResizeMode="NoResize" Height="550" WindowStartupLocation="CenterScreen"  Width="980"  WindowState="Normal"  WindowStyle="None"
        >
    <Border Name="brRef" Margin="3" Background="#DBDBDB" Grid.Column="1" Grid.Row="2" BorderBrush="#DBDBDB" BorderThickness="1" CornerRadius="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="0.15*"/>
                <RowDefinition Height="0.02*"/>
                <RowDefinition Height="0.8*"/>
                <RowDefinition Height="0.02*"/>
                <RowDefinition Height="0.25*"/>
                <RowDefinition Height="0.3*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Label Margin="0,10,0,0" Content="Marker Setting" VerticalAlignment="Top" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Grid.Row="0" Grid.Column="0"></Label>
            <!--<Image Name="btnClose" Margin="0,15,25,0" VerticalAlignment="Top" Width="30" MouseUp="Button_Click" HorizontalAlignment="Right" Source="/Images/Group 48.png" />-->
            <Border Width="80" Name="btnClose" Margin="0,15,25,0" MouseDown="Button_Click" Background="#305371" HorizontalAlignment="Right" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="10">
                <Label Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Close" ></Label>
            </Border>
            <Separator VerticalAlignment="Top" Grid.Row="1" Grid.Column="0"/>
            <Grid Margin="20,30,30,20" Grid.Row="2" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*" />
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>
                
                <Label Margin="20,0,0,0"  FontSize="16" FontWeight="Bold" Content="Marker 1"  Grid.Row="0" Grid.Column="0"></Label>
                <TextBox PreviewTextInput="PreviewTextInput_NumericOnly" Margin="0,0,20,0" FontSize="16"  VerticalAlignment="top" Grid.Row="0" Grid.Column="1" Name="txtM1" />
                <Label Content="Marker 2" FontSize="16" FontWeight="Bold" Grid.Row="0" Grid.Column="2"></Label>
                <TextBox PreviewTextInput="PreviewTextInput_NumericOnly" Margin="0,0,20,0" FontSize="16"  VerticalAlignment="top" Grid.Row="0" Grid.Column="3" Name="txtM2" />

                <Label Margin="20,0,0,0" Content="Start Peak Thresold" FontSize="16" FontWeight="Bold" Grid.Row="1" Grid.Column="0"></Label>
                <TextBox PreviewTextInput="PreviewTextInput_NumericOnly" Margin="0,0,20,0" FontSize="16"  VerticalAlignment="top" Grid.Row="1" Grid.Column="1" Name="txtSPT" />

                <Label Margin="0,0,0,0" Content="Stop Peak Thresold" FontSize="16" FontWeight="Bold" Grid.Row="1" Grid.Column="2"></Label>
                <TextBox PreviewTextInput="PreviewTextInput_NumericOnly" Margin="0,0,20,0" FontSize="16"  VerticalAlignment="top" Grid.Row="1" Grid.Column="3" Name="txtSPT1" />

                <Label Margin="20,0,0,0" Content="Start Peak Ignore Default (mm)" FontSize="16" FontWeight="Bold" Grid.Row="2" Grid.Column="0"></Label>
                <TextBox PreviewTextInput="PreviewTextInput_NumericOnly" Margin="0,0,20,0" FontSize="16"  VerticalAlignment="top" Grid.Row="2" Grid.Column="1" Name="txtSPID" />

                <Label Margin="0,0,0,0" Content="Start Peak Ignore (mm)" FontSize="16" FontWeight="Bold" Grid.Row="2" Grid.Column="2"></Label>
                <TextBox PreviewTextInput="PreviewTextInput_NumericOnly" Margin="0,0,20,0" FontSize="16"  VerticalAlignment="top" Grid.Row="2" Grid.Column="3" Name="txtSPI" />

                <Label Margin="20,0,0,0" Content="Stop Peak Ignore Default (mm)" FontSize="16" FontWeight="Bold" Grid.Row="3" Grid.Column="0"></Label>
                <TextBox PreviewTextInput="PreviewTextInput_NumericOnly" Margin="0,0,20,0" FontSize="16"  VerticalAlignment="top" Grid.Row="3" Grid.Column="1" Name="txtSPID1" />

                <Label Margin="0,0,0,0" Content="Stop Peak Ignore (mm)" FontSize="16" FontWeight="Bold" Grid.Row="3" Grid.Column="2"></Label>
                <TextBox PreviewTextInput="PreviewTextInput_NumericOnly" Margin="0,0,20,0" FontSize="16"  VerticalAlignment="top" Grid.Row="3" Grid.Column="3" Name="txtSPI1" />


                <Label Margin="20,0,0,0" Content="Fist Sensor to First Coil Sensor Distance(mm)" FontSize="16" FontWeight="Bold" Grid.Row="4" Grid.Column="0"></Label>
                <TextBox PreviewTextInput="PreviewTextInput_NumericOnly" Margin="0,0,20,0" FontSize="16"  VerticalAlignment="top" Grid.Row="4" Grid.Column="1" Name="txtFSFC" />

                <Label Margin="0,0,0,0" Content="Fist Coil to Coil Distance(mm)" FontSize="16" FontWeight="Bold" Grid.Row="4" Grid.Column="2"></Label>
                <TextBox PreviewTextInput="PreviewTextInput_NumericOnly" Margin="0,0,20,0" FontSize="16"  VerticalAlignment="top" Grid.Row="4" Grid.Column="3" Name="txtFCC" />


                <Label Margin="20,0,0,0" Content="Coil to Second Coil Sensor Distance(mm)" FontSize="16" FontWeight="Bold" Grid.Row="5" Grid.Column="0"></Label>
                <TextBox PreviewTextInput="PreviewTextInput_NumericOnly" Margin="0,0,20,0" FontSize="16"  VerticalAlignment="top" Grid.Row="5" Grid.Column="1" Name="txtCSCC" />

                

            </Grid>
            <Separator VerticalAlignment="Top" Grid.Row="3" Grid.Column="0"/>
            <!--<Button FontWeight="Bold"  Margin="20,0,0,0" MaxWidth="150" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="4" Grid.Column="0" Content="Save Config" Name="btnConfigSave" Click="btnConfigSave_Click" ></Button>-->

            <Border Width="250" Name="btnConfigSave" MouseDown="btnConfigSave_Click" Margin="18" Background="#305371" Grid.Column="0" Grid.Row="4" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="10">
                <Label Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Save Config" ></Label>
            </Border>

            <Label Content="" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Top" Name="lblMsg" Grid.Row="5" Grid.Column="0"></Label>

        </Grid>
    </Border>
</Window>
