<Window x:Class="Eddy.MarkerSetting"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Eddy"
        mc:Ignorable="d"
        Title="Window1" 
        ResizeMode="NoResize" Height="450" WindowStartupLocation="CenterScreen"  Width="980"  WindowState="Normal"  WindowStyle="None"
        >
    <Border Name="brRef" Margin="3" Background="#DBDBDB" Grid.Column="1" Grid.Row="2" BorderBrush="#DBDBDB" BorderThickness="1" CornerRadius="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="0.15*"/>
                <RowDefinition Height="0.02*"/>
                <RowDefinition Height="0.6*"/>
                <RowDefinition Height="0.02*"/>
                <RowDefinition Height="0.25*"/>
                <RowDefinition Height="0.3*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Label Margin="0,10,0,0" Content="Marker Setting" VerticalAlignment="Top" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Grid.Row="0" Grid.Column="0"></Label>
            <!--<Image Name="btnClose" Margin="0,15,25,0" VerticalAlignment="Top" Width="30" MouseUp="Button_Click" HorizontalAlignment="Right" Source="/Images/Group 48.png" />-->
            <Border Width="80" Name="btnClose" Margin="0,15,25,0" MouseDown="Button_Click" Background="#305371" HorizontalAlignment="Right" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="10">
                <Label Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Close" ></Label>
            </Border>
            <Separator VerticalAlignment="Top" Grid.Row="1" Grid.Column="0"/>
            <Grid Margin="20,30,30,20" Grid.Row="2" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="257*" />
                    <ColumnDefinition Width="51*"/>
                    <ColumnDefinition Width="154*"/>
                    <ColumnDefinition Width="307*"/>
                    <ColumnDefinition Width="154*"/>
                </Grid.ColumnDefinitions>

                <Label Margin="20,0,0,29"  FontSize="16" FontWeight="Bold" Content="Marker 1 (ms)"  Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Grid.RowSpan="2"></Label>
                <TextBox PreviewTextInput="PreviewTextInput_NumericOnly" Margin="50,0,20,0" FontSize="16"  VerticalAlignment="Top" Grid.Row="0" Grid.Column="1" Name="txtM1" Grid.ColumnSpan="2" />
                <Label Content="Marker 2 (ms)" FontSize="16" FontWeight="Bold" Grid.Row="0" Grid.Column="3" Margin="0,0,0,29" Grid.RowSpan="2"></Label>
                <TextBox PreviewTextInput="PreviewTextInput_NumericOnly" Margin="307,0,20,0" FontSize="16"  VerticalAlignment="Top" Grid.Row="0" Grid.Column="3" Name="txtM2" Grid.ColumnSpan="2" />


                <Label Margin="20,0,0,0" Content="Front Delay (ms)" FontSize="16" FontWeight="Bold" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"></Label>
                <TextBox PreviewTextInput="PreviewTextInput_NumericOnly" Margin="50,0,20,0" FontSize="16"  VerticalAlignment="Top" Grid.Row="1" Grid.Column="1" Name="txtFMS" Grid.ColumnSpan="2" />


                <Label Content="Rear Delay (ms)" Foreground="Gray" FontSize="16" FontWeight="Bold" Grid.Row="1" Grid.Column="3"/>
                <TextBox PreviewTextInput="PreviewTextInput_NumericOnly"  BorderBrush="Gray" Foreground="Gray" Margin="307,0,20,0" FontSize="16"  VerticalAlignment="Top" Grid.Row="1" Grid.Column="3" Name="txtRMS" Grid.ColumnSpan="2" />


                <Label Margin="20,29,0,29" Content="Paint Spray Time (ms)" FontSize="16" FontWeight="Bold" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Grid.RowSpan="3"></Label>
                <TextBox PreviewTextInput="PreviewTextInput_NumericOnly" Margin="50,29,20,0" FontSize="16"  VerticalAlignment="Top" Grid.Row="1" Grid.Column="1" Name="txtPMS" Grid.ColumnSpan="2" Grid.RowSpan="2" />

                <Label Margin="0,29,0,29" Content="C1 to C2 Sensor Distance (mm)" FontSize="16" FontWeight="Bold" Grid.Row="1" Grid.Column="3" Grid.RowSpan="3"></Label>
                <TextBox PreviewTextInput="PreviewTextInput_NumericOnly" Margin="307,29,20,0" FontSize="16"  VerticalAlignment="Top" Grid.Row="1" Grid.Column="3" Name="txtC1C2" Grid.ColumnSpan="2" Grid.RowSpan="2" />

                <Label Margin="20,0,0,0" Content="C2 to Exit Sensor Distance (mm)" FontSize="16" FontWeight="Bold" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"></Label>
                <TextBox PreviewTextInput="PreviewTextInput_NumericOnly" Margin="50,0,20,0" FontSize="16"  VerticalAlignment="Top" Grid.Row="3" Grid.Column="1" Name="txtC2E" Grid.ColumnSpan="2" />

                <Label Content="C Coil to C2 Sensor Distance (mm)" FontSize="16" FontWeight="Bold" Grid.Row="3" Grid.Column="3"/>
                <TextBox PreviewTextInput="PreviewTextInput_NumericOnly" Margin="307,0,20,0" FontSize="16"  VerticalAlignment="Top" Grid.Row="3" Grid.Column="3" Name="txtCC2" Grid.ColumnSpan="2" />

                <Label Margin="20,29,0,0" Name="lblMABS"  FontSize="16" FontWeight="Bold" Content="Marker ABS (ms)"  Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Grid.RowSpan="2"></Label>
                <TextBox PreviewTextInput="PreviewTextInput_NumericOnly" Margin="50,29,20,0" FontSize="16"  VerticalAlignment="Top" Grid.Row="3" Grid.Column="1" Name="txtMABS" Grid.ColumnSpan="2" Grid.RowSpan="2" />


            </Grid>
            <Separator VerticalAlignment="Top" Grid.Row="3" Grid.Column="0"/>
            <!--<Button FontWeight="Bold"  Margin="20,0,0,0" MaxWidth="150" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="4" Grid.Column="0" Content="Save Config" Name="btnConfigSave" Click="btnConfigSave_Click" ></Button>-->

            <Border Width="250" Name="btnConfigSave" MouseDown="btnConfigSave_Click" Margin="18" Background="#305371" Grid.Column="0" Grid.Row="4" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="10">
                <Label Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Save Config" ></Label>
            </Border>

            <Label Content="" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Top" Name="lblMsg" Grid.Row="5" Grid.Column="0"></Label>

        </Grid>
    </Border>
</Window>
