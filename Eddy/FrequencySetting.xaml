<Window x:Class="Eddy.FrequencySetting"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Eddy"
        mc:Ignorable="d"
        Title="Window1" 
        ResizeMode="NoResize" Height="750" WindowStartupLocation="CenterScreen"  Width="850"  WindowState="Normal"  WindowStyle="None"
        >
    <Border Name="brRef" Margin="3" Background="#DBDBDB" Grid.Column="1" Grid.Row="2" BorderBrush="#DBDBDB" BorderThickness="1" CornerRadius="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="0.07*"/>
                <RowDefinition Height="0.011*"/>
                <RowDefinition Height="0.6*"/>
                <RowDefinition Height="0.011*"/>
                <RowDefinition Height="0.11*"/>
                <RowDefinition Height="0.07*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Label Margin="0,10,0,0" Content="Frequency Setting" VerticalAlignment="Top" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Grid.Row="0" Grid.Column="0"></Label>
            <!--<Image Name="btnClose" Margin="0,15,25,0" VerticalAlignment="Top" Width="30" MouseUp="Button_Click" HorizontalAlignment="Right" Source="/Images/Group 48.png" />-->
            <Border Width="80" Name="btnClose" Margin="0,15,25,0" MouseDown="Button_Click" Background="#305371" HorizontalAlignment="Right" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="10">
                <Label Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Close" ></Label>
            </Border>
            <Separator VerticalAlignment="Top" Grid.Row="1" Grid.Column="0"/>
            <Grid Margin="20,30,30,20" Grid.Row="2" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>

                    <!--<RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>-->
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                
                <Label Margin="0,0,0,0"  FontSize="16" FontWeight="Bold" Content="D1"  Grid.Row="0" Grid.Column="0"></Label>
                <CheckBox Name="chkD1" Grid.Row="0" Grid.Column="1"/>
                <Label Margin="0,0,0,0"  FontSize="16" FontWeight="Bold" Content="D2"  Grid.Row="0" Grid.Column="2"></Label>
                <CheckBox Name="chkD2" Grid.Row="0" Grid.Column="3"/>
                <Label Margin="0,0,0,0"  FontSize="16" FontWeight="Bold" Content="D3"  Grid.Row="0" Grid.Column="4"></Label>
                <CheckBox Name="chkD3" Grid.Row="0" Grid.Column="5"/>

                <Label Content="Phase" FontSize="16" FontWeight="Bold" Grid.Row="1" Grid.Column="0"></Label>
                <TextBox PreviewTextInput="PreviewTextInput_NumericOnly" Margin="0,0,20,0" FontSize="16"  VerticalAlignment="top" Grid.Row="1" Grid.Column="1" Name="txtPhase1" />
                <Label Content="Phase" FontSize="16" FontWeight="Bold" Grid.Row="1" Grid.Column="2"></Label>
                <TextBox PreviewTextInput="PreviewTextInput_NumericOnly" Margin="0,0,20,0" FontSize="16"  VerticalAlignment="top" Grid.Row="1" Grid.Column="3" Name="txtPhase2" />
                <Label Content="Phase" FontSize="16" FontWeight="Bold" Grid.Row="1" Grid.Column="4"></Label>
                <TextBox PreviewTextInput="PreviewTextInput_NumericOnly" Margin="0,0,20,0" FontSize="16"  VerticalAlignment="top" Grid.Row="1" Grid.Column="5" Name="txtPhase3" />

                <Label Content="Gain" FontSize="16" FontWeight="Bold" Grid.Row="2" Grid.Column="0"></Label>
                <TextBox PreviewTextInput="PreviewTextInput_NumericOnly" Grid.Row="2" Margin="0,0,20,0" FontSize="16"  VerticalAlignment="top"  Grid.Column="1" Name="txtGain1" />
                <Label Content="Gain" FontSize="16" FontWeight="Bold" Grid.Row="2" Grid.Column="2"></Label>
                <TextBox PreviewTextInput="PreviewTextInput_NumericOnly" Grid.Row="2" Margin="0,0,20,0" FontSize="16"  VerticalAlignment="top"  Grid.Column="3" Name="txtGain2" />
                <Label Content="Gain" FontSize="16" FontWeight="Bold" Grid.Row="2" Grid.Column="4"></Label>
                <TextBox PreviewTextInput="PreviewTextInput_NumericOnly" Grid.Row="2"  Margin="0,0,20,0" FontSize="16"  VerticalAlignment="top" Grid.Column="5" Name="txtGain3" />

                <Label Content="High Thresold" FontSize="16" FontWeight="Bold" Grid.Row="3" Grid.Column="0"></Label>
                <TextBox PreviewTextInput="PreviewTextInput_NumericOnly" Grid.Row="3" Margin="0,0,20,0" FontSize="16"  VerticalAlignment="top"  Grid.Column="1" Name="txtUTH1" />
                <Label Content="High Thresold" FontSize="16" FontWeight="Bold" Grid.Row="3" Grid.Column="2"></Label>
                <TextBox PreviewTextInput="PreviewTextInput_NumericOnly" Grid.Row="3" Margin="0,0,20,0" FontSize="16"  VerticalAlignment="top"  Grid.Column="3" Name="txtUTH2" />
                <Label Content="High Thresold" FontSize="16" FontWeight="Bold" Grid.Row="3" Grid.Column="4"></Label>
                <TextBox PreviewTextInput="PreviewTextInput_NumericOnly" Grid.Row="3"  Margin="0,0,20,0" FontSize="16"  VerticalAlignment="top" Grid.Column="5" Name="txtUTH3" />

                <Label Content="Low Thresold" FontSize="16" FontWeight="Bold" Grid.Row="4" Grid.Column="0"></Label>
                <TextBox PreviewTextInput="PreviewTextInput_NumericOnly" Grid.Row="4" Margin="0,0,20,0" FontSize="16"  VerticalAlignment="top"  Grid.Column="1" Name="txtLTH1" />
                <Label Content="Low Thresold" FontSize="16" FontWeight="Bold" Grid.Row="4" Grid.Column="2"></Label>
                <TextBox PreviewTextInput="PreviewTextInput_NumericOnly" Grid.Row="4" Margin="0,0,20,0" FontSize="16"  VerticalAlignment="top"  Grid.Column="3" Name="txtLTH2" />
                <Label Content="Low Thresold" FontSize="16" FontWeight="Bold" Grid.Row="4" Grid.Column="4"></Label>
                <TextBox PreviewTextInput="PreviewTextInput_NumericOnly" Grid.Row="4"  Margin="0,0,20,0" FontSize="16"  VerticalAlignment="top" Grid.Column="5" Name="txtLTH3" />

                <Label Content="PP" FontSize="16" FontWeight="Bold" Grid.Row="5" Grid.Column="0"></Label>
                <TextBox PreviewTextInput="PreviewTextInput_NumericOnly" Grid.Row="5" Margin="0,0,20,0" FontSize="16"  VerticalAlignment="top"  Grid.Column="1" Name="txtPP1" />
                <Label Content="PP" FontSize="16" FontWeight="Bold" Grid.Row="5" Grid.Column="2"></Label>
                <TextBox PreviewTextInput="PreviewTextInput_NumericOnly" Grid.Row="5" Margin="0,0,20,0" FontSize="16"  VerticalAlignment="top"  Grid.Column="3" Name="txtPP2" />
                <Label Content="PP" FontSize="16" FontWeight="Bold" Grid.Row="5" Grid.Column="4"></Label>
                <TextBox PreviewTextInput="PreviewTextInput_NumericOnly" Grid.Row="5"  Margin="0,0,20,0" FontSize="16"  VerticalAlignment="top" Grid.Column="5" Name="txtPP3" />

                <Label Content="PM" FontSize="16" FontWeight="Bold" Grid.Row="6" Grid.Column="0"></Label>
                <TextBox PreviewTextInput="PreviewTextInput_NumericOnly" Grid.Row="6" Margin="0,0,20,0" FontSize="16"  VerticalAlignment="top"  Grid.Column="1" Name="txtPM1" />
                <Label Content="PM" FontSize="16" FontWeight="Bold" Grid.Row="6" Grid.Column="2"></Label>
                <TextBox PreviewTextInput="PreviewTextInput_NumericOnly" Grid.Row="6" Margin="0,0,20,0" FontSize="16"  VerticalAlignment="top"  Grid.Column="3" Name="txtPM2" />
                <Label Content="PM" FontSize="16" FontWeight="Bold" Grid.Row="6" Grid.Column="4"></Label>
                <TextBox PreviewTextInput="PreviewTextInput_NumericOnly" Grid.Row="6"  Margin="0,0,20,0" FontSize="16"  VerticalAlignment="top" Grid.Column="5" Name="txtPM3" />


                <Label Content="H" FontSize="16" FontWeight="Bold" Grid.Row="7" Grid.Column="0"></Label>
                <TextBox PreviewTextInput="PreviewTextInput_NumericOnly" Grid.Row="7" Margin="0,0,20,0" FontSize="16"  VerticalAlignment="top"  Grid.Column="1" Name="txtH1" />
                <Label Content="H" FontSize="16" FontWeight="Bold" Grid.Row="7" Grid.Column="2"></Label>
                <TextBox PreviewTextInput="PreviewTextInput_NumericOnly" Grid.Row="7" Margin="0,0,20,0" FontSize="16"  VerticalAlignment="top"  Grid.Column="3" Name="txtH2" />
                <Label Content="H" FontSize="16" FontWeight="Bold" Grid.Row="7" Grid.Column="4"></Label>
                <TextBox PreviewTextInput="PreviewTextInput_NumericOnly" Grid.Row="7"  Margin="0,0,20,0" FontSize="16"  VerticalAlignment="top" Grid.Column="5" Name="txtH3" />

                <Label Content="L" FontSize="16" FontWeight="Bold" Grid.Row="8" Grid.Column="0"></Label>
                <TextBox PreviewTextInput="PreviewTextInput_NumericOnly" Grid.Row="8" Margin="0,0,20,0" FontSize="16"  VerticalAlignment="top"  Grid.Column="1" Name="txtL1" />
                <Label Content="L" FontSize="16" FontWeight="Bold" Grid.Row="8" Grid.Column="2"></Label>
                <TextBox PreviewTextInput="PreviewTextInput_NumericOnly" Grid.Row="8" Margin="0,0,20,0" FontSize="16"  VerticalAlignment="top"  Grid.Column="3" Name="txtL2" />
                <Label Content="L" FontSize="16" FontWeight="Bold" Grid.Row="8" Grid.Column="4"></Label>
                <TextBox PreviewTextInput="PreviewTextInput_NumericOnly" Grid.Row="8"  Margin="0,0,20,0" FontSize="16"  VerticalAlignment="top" Grid.Column="5" Name="txtL3" />

            </Grid>
            <Separator VerticalAlignment="Top" Grid.Row="3" Grid.Column="0"/>
            <!--<Button FontWeight="Bold"  Margin="20,0,0,0" MaxWidth="150" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="4" Grid.Column="0" Content="Save Config" Name="btnConfigSave" Click="btnConfigSave_Click" ></Button>-->

            <Border Width="250" Name="btnConfigSave" MouseDown="btnConfigSave_Click" Margin="18" Background="#305371" Grid.Column="0" Grid.Row="4" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="10">
                <Label Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Save Config" ></Label>
            </Border>

            <Label Content="" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Top" Name="lblMsg" Grid.Row="5" Grid.Column="0"></Label>

        </Grid>
    </Border>
</Window>
