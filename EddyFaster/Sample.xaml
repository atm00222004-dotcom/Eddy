<Window x:Class="_8F.Sample"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_8F"
        mc:Ignorable="d"
        Title="8F" 
        WindowStyle="None" 
        WindowState="Maximized" ResizeMode="NoResize" 
        >
    <Grid>

            <!-- ===================== ROWS ===================== -->
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <!-- Top Menu -->
                <RowDefinition Height="*"/>
                <!-- Main Area -->
                <RowDefinition Height="60"/>
                <!-- Bottom Status -->
            </Grid.RowDefinitions>

            <!-- ===================== TOP MENU ===================== -->
            <Grid Grid.Row="0" Background="#1f2d3a">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="File" Foreground="White" FontSize="14" Margin="0,0,20,0"/>
                    <TextBlock Text="Configuration" Foreground="White" FontSize="14" Margin="0,0,20,0"/>
                    <TextBlock Text="View Log" Foreground="White" FontSize="14"/>
                </StackPanel>
           
        </Grid>

            <!-- ===================== MAIN AREA ===================== -->
            <Grid Grid.Row="1" Margin="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <!-- Graph -->
                    <ColumnDefinition Width="2*"/>
                    <!-- Right Panel -->
                </Grid.ColumnDefinitions>

                <!-- ===================== GRAPH PANEL ===================== -->
                <Border Grid.Column="0"
                    Background="#F5F5F5"
                    CornerRadius="8"
                    BorderBrush="#2c3e50"
                    BorderThickness="2"
                    Padding="10">

                    <Grid>
                        <TextBlock Text="D1 - 400Hz"
                               FontWeight="Bold"
                               FontSize="16"
                               Foreground="Black"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Margin="5"/>

                        <!-- Graph Canvas -->
                        <Canvas Margin="0,30,0,0">
                            <!-- Outer Circle -->
                            <Ellipse Width="300" Height="300"
                                 Stroke="Orange"
                                 StrokeThickness="2"
                                 Canvas.Left="250"
                                 Canvas.Top="150"/>

                            <!-- Inner Circle -->
                            <Ellipse Width="180" Height="180"
                                 Stroke="Black"
                                 StrokeThickness="2"
                                 Canvas.Left="310"
                                 Canvas.Top="210"/>

                            <!-- Cross Lines -->
                            <Line X1="0" Y1="300" X2="800" Y2="300"
                              Stroke="Gray" StrokeThickness="1"/>
                            <Line X1="400" Y1="0" X2="400" Y2="600"
                              Stroke="Gray" StrokeThickness="1"/>
                        </Canvas>
                    </Grid>
                </Border>

                <!-- ===================== RIGHT CONTROL PANEL ===================== -->
                <StackPanel Grid.Column="1" Margin="20,0,0,0">

                    <!-- Buttons Panel -->
                    <Border Background="#1f2d3a"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,20">

                        <StackPanel>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <Button Content="Start Test"
                                    Background="#28B463"
                                    Foreground="White"
                                    Height="45"
                                    Margin="5"
                                    FontWeight="Bold"/>

                                <Button Content="Stop Test"
                                    Grid.Column="1"
                                    Background="#E74C3C"
                                    Foreground="White"
                                    Height="45"
                                    Margin="5"
                                    FontWeight="Bold"/>
                            </Grid>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <Button Content="Balance"
                                    Background="#2E86C1"
                                    Foreground="White"
                                    Height="45"
                                    Margin="5"/>

                                <Button Content="Clear"
                                    Grid.Column="1"
                                    Background="#566573"
                                    Foreground="White"
                                    Height="45"
                                    Margin="5"/>
                            </Grid>

                            <Button Content="Start Log"
                                Background="#5B2C6F"
                                Foreground="White"
                                Height="45"
                                Margin="5"/>
                        </StackPanel>
                    </Border>

                    <!-- Production Panel -->
                    <Border Background="#1f2d3a"
                        CornerRadius="8"
                        Padding="20">

                        <StackPanel>

                            <TextBlock Text="Production"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,0,0,15"/>

                            <TextBlock Text="Total Count : 120"
                                   Foreground="White"
                                   FontSize="16"
                                   Margin="0,5"/>

                            <TextBlock Text="OK Count : 115"
                                   Foreground="#28B463"
                                   FontSize="16"
                                   Margin="0,5"/>

                            <TextBlock Text="Not OK : 5"
                                   Foreground="#E74C3C"
                                   FontSize="16"
                                   Margin="0,5"/>

                            <Button Content="Reset Count"
                                Background="#2E86C1"
                                Foreground="White"
                                Height="40"
                                Margin="0,15,0,10"/>

                            <TextBlock Text="Overall Result : OK"
                                   Foreground="#28B463"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

            </Grid>

            <!-- ===================== BOTTOM STATUS BAR ===================== -->
            <Grid Grid.Row="2" Background="#1f2d3a">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="20,0">
                    <Ellipse Width="12" Height="12"
                         Fill="#28B463"
                         Margin="0,0,10,0"/>
                    <TextBlock Text="Connection: Connected"
                           Foreground="White"
                           FontSize="14"
                           Margin="0,0,20,0"/>
                    <TextBlock Text="Mode: Auto"
                           Foreground="White"
                           FontSize="14"
                           Margin="0,0,20,0"/>
                    <TextBlock Text="Time: 12:45:33"
                           Foreground="White"
                           FontSize="14"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                       Text="Time: 12:45:33 PM"
                       Foreground="White"
                       FontSize="16"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Margin="0,0,20,0"/>
            </Grid>

        </Grid>
    </Window>
