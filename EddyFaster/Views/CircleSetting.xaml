<Window x:Class="_8F.Views.CircleSetting"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_8F"
        mc:Ignorable="d"
        Title="Circle Setting" 
        ResizeMode="NoResize"  Height="450" WindowStartupLocation="CenterScreen" Closing="Window_Closing"  Width="600"  WindowState="Normal" WindowStyle="None"
        >
    <Border Name="brRef" Margin="3" Background="#DBDBDB" Grid.Column="1" Grid.Row="2" BorderBrush="#DBDBDB" BorderThickness="1" CornerRadius="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="0*"/>
                <RowDefinition Height="0.25*"/>
                <RowDefinition Height="0.04*"/>
                <RowDefinition Height=".7*"/>
                <RowDefinition Height="0.01*"/>
                <RowDefinition Height="0.25*"/>
                <RowDefinition Height="0.3*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <ComboBox IsEnabled="False" Margin="20,10,20,0" FontSize="22" VerticalAlignment="Top" Grid.Row="0" Grid.Column="0" SelectionChanged="ddlFrChennel_SelectionChanged"  Name="ddlFrChennel" />
            <Label Margin="0,10,0,0"  Content="System Configuration" VerticalAlignment="Top" FontSize="22" FontWeight="Bold" Name="lblHeader" HorizontalAlignment="Center" Grid.Row="1" Grid.Column="0"></Label>
            <!--<Image Name="btnClose" Margin="0,15,25,0" VerticalAlignment="Top" Width="30" MouseUp="Button_Click" HorizontalAlignment="Right" Source="/Images/Group 48.png" />-->
            <Border Visibility="Hidden" Width="80" Name="btnNew" Margin="25,15,0,0" MouseDown="btnNew_MouseDown" Grid.Row="1" Grid.Column="0"  Background="#305371" HorizontalAlignment="Left" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="10">
                <Label Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Add New" ></Label>
            </Border>

            <Border Width="80" Name="btnClose" Margin="0,15,25,0" MouseDown="Button_Click" Grid.Row="1" Grid.Column="0" Background="#305371" HorizontalAlignment="Right" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="10">
                <Label Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Close" ></Label>
            </Border>
            <Separator VerticalAlignment="Top" Grid.Row="2" Grid.Column="0"/>
            <Grid  Grid.Row="3" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.75*"/>
                    <RowDefinition Height="0.75*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Grid.Row="0" Grid.Column="0" Margin="0,0,0,5"  BorderThickness="1" CornerRadius="10">
                    <DataGrid  ItemsSource="{Binding ellipses}" SelectionMode="Single" CanUserSortColumns="false" FontSize="18" CanUserAddRows="false" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" Margin="2" AutoGenerateColumns="False" Name="gdFreq" VerticalAlignment="Top">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="200*" Header = "Height" Binding = "{Binding height}" />
                            <DataGridTextColumn Width="200*" Header = "Width" Binding = "{Binding width}"/>
                            <DataGridTextColumn Width="200*" Header = "X" Binding = "{Binding ex}"/>
                            <DataGridTextColumn Width="200*" Header = "Y" Binding = "{Binding ey}"/>
                            <DataGridTextColumn Width="200*" Header = "Angle" Binding = "{Binding angel}"/>
                            <!--<DataGridTextColumn Width="200*" Header = "Color" Binding = "{Binding ColorName}"/>-->
                            <!--<DataGridTemplateColumn>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button x:Name="btn_installSnippet" Click="btn_installSnippet_Click">Remove</Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>-->
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                <Grid  Grid.Row="3" Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.5*"/>
                        <RowDefinition Height="1.5*"/>
                        <!--<RowDefinition Height="1*"/>-->
                        <!--<RowDefinition Height="3*" />-->
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <Label Margin="20,0,0,0" Content="Outer diameter" FontSize="14" FontWeight="Bold" Grid.Row="0" Grid.Column="0"></Label>
                    <TextBox PreviewTextInput="PreviewTextInput_NumericOnly"  Margin="0,0,20,0" FontSize="14"  VerticalAlignment="top" Grid.Row="0" Grid.Column="1" Name="txtWidth" />

                    <Label Visibility="Hidden" Content="Outer Height" FontSize="14" FontWeight="Bold" Grid.Row="0" Grid.Column="2"></Label>
                    <TextBox Visibility="Hidden" PreviewTextInput="PreviewTextInput_NumericOnly"  Margin="0,0,20,0" FontSize="14"  VerticalAlignment="top" Grid.Row="0" Grid.Column="3" Name="txtHeight" />

                    <Label Margin="20,0,0,0" Content="Solenoid (ms)" FontSize="14" FontWeight="Bold" Grid.Row="0" Grid.Column="2"></Label>
                    <TextBox PreviewTextInput="PreviewTextInput_NumericOnly"  Margin="0,0,20,0" FontSize="14"  VerticalAlignment="top" Grid.Row="0" Grid.Column="3" Name="txtAngel" />
                    
                    <Label Margin="20,0,0,0" Content="NG Solenoid (ms)" FontSize="14" FontWeight="Bold" Grid.Row="1" Grid.Column="0"></Label>
                    <TextBox PreviewTextInput="PreviewTextInput_NumericOnly"  Margin="0,0,20,0" FontSize="14"  VerticalAlignment="top" Grid.Row="1" Grid.Column="1" Name="txtNGSolenoid" />

                </Grid>
            </Grid>
            <Separator VerticalAlignment="Top" Grid.Row="4" Grid.Column="0"/>
            <!--<Button FontWeight="Bold"  Margin="20,0,0,0" MaxWidth="150" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="4" Grid.Column="0" Content="Save Config" Name="btnConfigSave" Click="btnConfigSave_Click" ></Button>-->

            <Border Width="250" Name="btnConfigSave" MouseDown="btnConfigSave_Click" Margin="1" Background="#305371" Grid.Column="0" Grid.Row="5" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="10">
                <Label Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Save Config" ></Label>
            </Border>

            <Label Content="" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Top" Name="lblMsg" Grid.Row="6" Grid.Column="0"></Label>

        </Grid>
    </Border>
</Window>
