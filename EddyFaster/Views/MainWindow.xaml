<Window x:Class="_8F.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_8F.Views"
        mc:Ignorable="d"
        Title="8F" 
        WindowStyle="None" 
        WindowState="Maximized" ResizeMode="NoResize" Closed="Window_Closed" KeyDown="Window_KeyDown"
        >
    <Grid Background="Black" Margin="2">

        <!-- Main Layout -->
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Content -->
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->
        <Grid Grid.Row="0" Background="LightGray">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="450"/>
            </Grid.ColumnDefinitions>

            <!-- Menu -->
            <Menu Background="LightGray"
              VerticalAlignment="Center"
              Height="30"
              FontSize="16"
              ItemsSource="{Binding MenuItems}">
                <Menu.ItemContainerStyle>
                    <Style TargetType="{x:Type MenuItem}">
                        <Setter Property="Command" Value="{Binding Command}" />
                    </Style>
                </Menu.ItemContainerStyle>
                <Menu.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type local:MenuItemViewModel}" ItemsSource="{Binding Path=MenuItems}">
                        <TextBlock Text="{Binding Header}"/>
                    </HierarchicalDataTemplate>
                </Menu.ItemTemplate>
            </Menu>

            <!-- Status Area -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5">
                <Label Width="100" Name="lblPartLogs" Foreground="Black" FontSize="12" FontWeight="Bold" Margin="5,0"/>
          
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5">
                <Label Name="lblConfigFileName" Foreground="Black" FontSize="12" FontWeight="Bold" Margin="5,0"/>
                <!--<Label Name="lblState" Content="Test Off" FontSize="12" FontWeight="Bold" Margin="5,0"/>-->
                <Border Name="brStatus" Width="30" Height="20" Background="#305371" Margin="5"/>
            </StackPanel>
        </Grid>

        <!-- ================= CONTENT ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <!-- Graph Area -->
                <ColumnDefinition Width="420"/>
                <!-- Right Panel -->
            </Grid.ColumnDefinitions>

            <!-- ===== LEFT : GRAPH AREA ===== -->
            <Border Grid.Column="0"
                Margin="5"
                BorderThickness="2"
                BorderBrush="Gray"
                Background="#101010">

                <Viewbox Stretch="Uniform">
                    <!-- KEEP YOUR ORIGINAL CANVAS EXACTLY -->
                    <Canvas x:Name="Canvas1" Width="720" Height="720">

                        <Rectangle Name="br1_rec1" Width="360" Height="360" Fill="White"/>

                        <TextBlock Name="lblFreq1" Background="LightBlue" FontWeight="Bold" FontSize="14"/>

                        <Canvas Name="br1_can1" Canvas.Left="360">
                            <TextBlock Name="lblGraphXY1"              
               Background="LightBlue"
               FontWeight="Bold"
               FontSize="14"
               Canvas.Right="0"/>
                        </Canvas>

                        <Rectangle Name="br1_rec2" Width="360" Height="0.5" Canvas.Top="180" Fill="Black"/>
                        <Rectangle Name="br1_rec3" Width="0.5" Height="360" Canvas.Left="180" Fill="Black"/>

                        <Rectangle Name="rResult1" Width="20" Height="20" Canvas.Left="335" Canvas.Top="335" Fill="White"/>

                        <Canvas Name="cnBr1" Canvas.Left="180" Canvas.Top="180">
                            <Canvas Name="cn1" Panel.ZIndex="1"/>
                            <Canvas Name="cn2"/>
                            <Ellipse x:Name="el11"
                                 Width="650"
                                 Height="650"
                                 Stroke="Black">
                                <Ellipse.RenderTransform>
                                    <TransformGroup>
                                        <RotateTransform x:Name="rtAngel11"/>
                                        <TranslateTransform x:Name="tt11" X="-325" Y="-325"/>
                                    </TransformGroup>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Canvas>

                        <!-- Setting Button -->
                        <Border Name="D1"
                            Width="42"
                            Height="24"
                            Canvas.Left="5"
                            Canvas.Top="335"
                            Background="#305371"
                            CornerRadius="5"
                            MouseDown="D_Click">
                            <Label Foreground="White"
                               FontSize="9"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Content="Setting"/>
                        </Border>

                    </Canvas>
                </Viewbox>
            </Border>

            <!-- ===== RIGHT PANEL ===== -->
            <Grid Grid.Column="1" Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Buttons -->
                    <RowDefinition Height="Auto"/>
                    <!-- Counts -->
                    <RowDefinition Height="*"/>
                    <!-- Bottom -->
                </Grid.RowDefinitions>

                <!-- Control Buttons -->
                <UniformGrid Rows="3" Columns="2" Margin="0,5">
                    <Border Name="btnBalance2" Width="150" Height="64" Background="#305371" CornerRadius="10" Margin="8" MouseDown="btnBalance_Click">
                        <Label Content="Balance" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <Border Name="btnClear2" Width="150" Height="64" Background="#305371" CornerRadius="10" Margin="8" MouseDown="btnClear_Click">
                        <Label Content="Clear" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <Border Name="btnTest2" Width="150" Height="64" Background="#305371" CornerRadius="10" Margin="8" MouseDown="btnTest_Click">
                        <Label Content="Start Test" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <Border Name="btnStop" Width="150" Height="64" Background="#305371" CornerRadius="10" Margin="8" MouseDown="btnStop_MouseDown">
                        <Label Name="lblStop" Content="Stop Test" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    
                </UniformGrid>

                <!-- Counts -->
                <StackPanel Grid.Row="1" Margin="0,20,0,10">

                    <Border Name="btnLog2" Width="350" Height="64" Background="#305371" CornerRadius="10" Margin="8" MouseDown="btnLog_MouseDown">
                        <Label Name="lblLog2" Content="Start Log" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    
                    <Border Width="350" Height="40" Background="Brown" CornerRadius="10" HorizontalAlignment="Center" Margin="5">
                        <Label Name="lblTCount2" Content="Total Count - 0" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Width="170" Height="40" Background="Green" CornerRadius="10" Margin="5">
                            <Label Name="lblOkCount2" Content="OK Count - 0" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <Border Width="170" Height="40" Background="Red" CornerRadius="10" Margin="5">
                            <Label Name="lblNotOkCount2" Content="Not Ok Count - 0" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Bottom Buttons -->
                <StackPanel Grid.Row="3" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20">
                   
                    <Border Name="btnResetCounter2" Width="350" Height="70" Background="#305371" CornerRadius="10" Margin="8" MouseDown="btnResetCounter_Click">
                        <Label Content="Reset Count" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <Border Name="btnOverallResult2" Width="350" Height="70" Background="LightBlue" CornerRadius="10" Margin="8">
                        <Label Content="Overall Result" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

            </Grid>

        </Grid>
    </Grid>
