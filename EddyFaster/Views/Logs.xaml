<Window x:Class="_8F.Views.Logs"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_8F"
        mc:Ignorable="d"
        Title="Window1" 
        ResizeMode="NoResize" Height="600" WindowStartupLocation="CenterScreen"  Width="920"  WindowState="Normal"  WindowStyle="None"
        >
    <Window.Resources>
        <Style x:Key="styleCalendar" TargetType="{x:Type Calendar}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Calendar}">
                        <!-- Wrapping in ViewBox will enlarge calendar of that size.-->
                        <Viewbox Height="420"
                        Width="420">
                            <CalendarItem x:Name="PART_CalendarItem"
                                 Background="{TemplateBinding Background}"
                                 BorderBrush="{TemplateBinding BorderBrush}"
                                 BorderThickness="{TemplateBinding BorderThickness}"/>
                        </Viewbox>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Name="brRef" Margin="3" Background="#DBDBDB" Grid.Column="1" Grid.Row="2" BorderBrush="#DBDBDB" BorderThickness="1" CornerRadius="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="0.12*"/>
                <RowDefinition Height="0.04*"/>
                <RowDefinition Height="0.11*"/>
                <RowDefinition Height="0.04*"/>
                <RowDefinition Height="0.12*"/>
                <RowDefinition Height="0.9*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Label Margin="0,10,0,0" Content="View Log" VerticalAlignment="Top" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Grid.Row="0" Grid.Column="0"></Label>
            <!--<Image Name="btnClose" Margin="0,15,25,0" VerticalAlignment="Top" Width="30" MouseUp="Button_Click" HorizontalAlignment="Right" Source="/Images/Group 48.png" />-->
            <Border Width="80" Name="btnClose" Margin="0,15,25,0" MouseDown="Button_Click" Background="#305371" HorizontalAlignment="Right" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="10">
                <Label Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Close" ></Label>
            </Border>
            <Separator VerticalAlignment="Top" Grid.Row="1" Grid.Column="0"/>
            <Grid Grid.Row="2" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <!--<RowDefinition/>
                    <RowDefinition/>-->
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition/>
                    <ColumnDefinition />
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Label Margin="20,0,0,0" Content="Batch Name" FontSize="16" FontWeight="Bold" Grid.Row="0" Grid.Column="0"></Label>
                <TextBox  FontSize="20" VerticalAlignment="top" x:Name="txtBatchName" Grid.Row="0" Grid.Column="1" />
                
                <Label Margin="20,0,0,0" Content="Start Date" FontSize="16" FontWeight="Bold" Grid.Row="0" Grid.Column="2"></Label>
                <DatePicker CalendarStyle="{StaticResource styleCalendar}" FontSize="20" VerticalAlignment="top" x:Name="clStartDate" Grid.Row="0" Grid.Column="3" />

                <Label Content="End Date" FontSize="16" FontWeight="Bold" Grid.Row="0" Grid.Column="4"></Label>
                <DatePicker CalendarStyle="{StaticResource styleCalendar}" FontSize="20" VerticalAlignment="Top" x:Name="clToDate" Grid.Row="0" Grid.Column="5" />
            </Grid>
            <Separator VerticalAlignment="Top" Grid.Row="3" Grid.Column="0"/>

            <Grid  Grid.Row="4" Grid.Column="0" >
                <Grid.RowDefinitions>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Border Width="250" Name="btnSearch" MouseDown="btnSearch_MouseDown"  Margin="1" Background="#305371" Grid.Column="0" Grid.Row="0" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="10">
                    <Label Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Search" ></Label>
                </Border>

                <Border Width="250" Name="btnDownload" Margin="1" MouseDown="btnDownload_MouseDown" Background="#305371" Grid.Column="1" Grid.Row="0" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="10">
                    <Label Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Download" ></Label>
                </Border>

            </Grid>


            <Border Grid.Row="5" Grid.Column="0" Background="#1F1F1F" Margin="0,0,0,5" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="10">
                <DataGrid SelectionMode="Single" FontSize="18" IsReadOnly="True" CanUserAddRows="False" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" Margin="2" AutoGenerateColumns="False" Name="grdlogs" VerticalAlignment="Top">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="100*" Header = "Batch Name" Binding = "{Binding BatchName}"/>
                        <DataGridTextColumn Width="100*" Header = "Log Start Date" Binding = "{Binding LogStartDate}"/>
                        <DataGridTextColumn Width="100*" Header = "Log End Date" Binding = "{Binding LogEndDate}"/>
                        <DataGridTextColumn Width="100*" Header = "OK Count" Binding = "{Binding PassCount}"/>
                        <DataGridTextColumn Width="100*" Header = "Not OK Count" Binding = "{Binding FailCount}"/>
                        <DataGridTextColumn Width="100*" Header = "Total Count" Binding = "{Binding TotalCount}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

        </Grid>
    </Border>
</Window>
