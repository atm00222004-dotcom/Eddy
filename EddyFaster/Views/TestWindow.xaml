<Window x:Class="_8F.Views.TestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_8F"
        mc:Ignorable="d"
        Title="8F" 
        >

    <Grid Margin="2">
        <Grid.RowDefinitions>
            <RowDefinition Height=".8*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Canvas Name="cnBr1"  >
            <Ellipse x:Name="el1" HorizontalAlignment="Center" Height="400"  Stroke="Black" VerticalAlignment="Center" Width="250" Canvas.Left="0" Canvas.Top="0" RenderTransformOrigin="0,0">
                <Ellipse.RenderTransform>
                    <TransformGroup >
                        <RotateTransform x:Name="rtAngel1" CenterX="200" CenterY="125" Angle="20"/>
                        <TranslateTransform x:Name="tt1" X="50" Y="50"/>
                    </TransformGroup>
                </Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>
    </Grid>
</Window>
