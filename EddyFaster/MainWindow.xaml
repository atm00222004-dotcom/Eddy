<Window x:Class="_8F.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_8F"
        mc:Ignorable="d"
        Title="8F" 
        WindowStyle="None" 
        WindowState="Maximized" ResizeMode="NoResize" Closed="Window_Closed" KeyDown="Window_KeyDown"
        >

    <Grid Background="Black" Margin="2">
        <Grid.RowDefinitions>
            <RowDefinition Height=".35*"/>
            <!--change it from backend-->
            <RowDefinition Height=".5*"/>
            <!--change it from backend-->
            <RowDefinition Height="7*"/>
            <RowDefinition  Height="0*"/>
            <!--change it from backend-->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid Background="LightGray"   Grid.Row="0" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="9*"/>
                <ColumnDefinition Width="0.1*"/>
                <ColumnDefinition  Width="6*"/>
            </Grid.ColumnDefinitions>
            <Menu Background="LightGray"  VerticalAlignment="Center" Height="30" FontSize="18" Grid.Row="0" Grid.Column="0" DockPanel.Dock="Top" ItemsSource="{Binding MenuItems}">
                <Menu.ItemContainerStyle>
                    <Style TargetType="{x:Type MenuItem}">
                        <Setter Property="Command" Value="{Binding Command}" />
                    </Style>
                </Menu.ItemContainerStyle>
                <Menu.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type local:MenuItemViewModel}" ItemsSource="{Binding Path=MenuItems}">
                        <TextBlock Text="{Binding Header}"/>
                    </HierarchicalDataTemplate>
                </Menu.ItemTemplate>
            </Menu>
        </Grid>


        <Grid Grid.Column="0" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width=".1*"/>
                <ColumnDefinition Width=".12*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

            </Grid>
            <Grid Grid.Column="1" Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4.5*"/>
                    <ColumnDefinition  Width="4.5*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Label Name="lblPartLogs" Foreground="White" Content="" HorizontalAlignment="left" FontSize="12" FontWeight="Bold" Grid.Row="0" Grid.Column="0"></Label>
                <Label Name="lblConfigFileName" Foreground="White" Content="" HorizontalAlignment="Left" FontSize="12" FontWeight="Bold" Grid.Row="0" Grid.Column="1"></Label>
                <Border Panel.ZIndex="1000"  Name="brStatus" Margin="5"  Background="#305371" Grid.Column="2" Grid.Row="0" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="3">
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Column="0" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0*"/>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition Width="1.5*"/>
                <!--change it from backend-->
            </Grid.ColumnDefinitions>

            <Grid  Grid.Column="5" Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border Cursor="Hand" Width="150" Height="64" Name="btnBalance2" MouseDown="btnBalance_Click" Margin="8" Background="#305371" Grid.Column="0" Grid.Row="0" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="10">
                    <Label Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Balance" ></Label>
                </Border>

                <Border Cursor="Hand" Width="150" Height="64" Name="btnClear2" MouseDown="btnClear_Click" Margin="8" Background="#305371" Grid.Column="1" Grid.Row="0" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="10">
                    <Label Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Clear" ></Label>
                </Border>

                <!--<Border Cursor="Hand" Width="150" Height="64" Name="btnBalance2All" MouseDown="btnBalance_Click" Margin="8" Background="#305371" Grid.Column="1" Grid.Row="0" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="10">
                    <Label Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Balance All" ></Label>
                </Border>-->

                <Border Cursor="Hand" Width="150" Height="64" Name="btnTest2" MouseDown="btnTest_Click" Margin="8" Background="#305371" Grid.Column="0" Grid.Row="1" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="10">
                    <Label Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Start Test" ></Label>
                </Border>

                <Border MouseDown="btnStop_MouseDown" Visibility="Visible" Cursor="Hand" Width="150" Height="64" Name="btnStop" Margin="8" Background="#305371" Grid.Column="1" Grid.Row="1" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="10">
                    <Label Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Name="lblStop" HorizontalAlignment="Center" Content="Stop Test" ></Label>
                </Border>

                <!--<Border Cursor="Hand" Width="150" Height="64" Name="btnTest2All" MouseDown="btnTest_Click" Margin="8" Background="#305371" Grid.Column="1" Grid.Row="1" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="10">
                    <Label Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Test All" ></Label>
                </Border>-->



                <!--<Border Cursor="Hand" Width="150" Height="64" Name="btnClear2All" MouseDown="btnClear_Click" Margin="8" Background="#305371" Grid.Column="1" Grid.Row="2" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="10">
                    <Label Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Clear All" ></Label>
                </Border>-->

                <Border Visibility="Visible" Cursor="Hand" Width="150" Height="64" Name="btnLog2" MouseDown="btnLog_MouseDown"  Margin="8" Background="#305371" Grid.Column="0" Grid.Row="2" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="10">
                    <Label Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Name="lblLog2" HorizontalAlignment="Center" Content="Start Log" ></Label>
                </Border>


            </Grid>

            <Border x:Name="br1" Margin="2,2,2,2" Grid.Row="0" Grid.Column="1" BorderThickness="2" >
                <Canvas  x:Name="Canvas1" HorizontalAlignment="Left" Margin="0" VerticalAlignment="Top">
                    <Rectangle Name="br1_rec1" Width="360" Fill="White"
                        Height="360"
                        Canvas.Left="0"
                        Canvas.Top="0" />

                    <TextBlock Name="lblFreq1" Background="LightBlue" FontWeight="Bold" FontSize="14" Panel.ZIndex="1000" >

                    </TextBlock>

                    <Canvas Name="br1_can1" Canvas.Left="360" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <TextBlock HorizontalAlignment="Right" Canvas.Right="1" Name="lblGraphXY1" Background="LightBlue" FontWeight="Bold" FontSize="14" Panel.ZIndex="1000" >
                        </TextBlock>
                    </Canvas>

                    <Rectangle Name="br1_rec2" Width="360"
                        Height=".5"
                        Canvas.Left="0"
                               Fill="Black"
                        Canvas.Top="180" />

                    <Rectangle Name="br1_rec3" Width=".5"
                        Height="360"
                        Canvas.Left="180"
                        Fill="Black"
                        Canvas.Top="0" />

                    <Rectangle Width="20" Name="rResult1" Panel.ZIndex="1000"
                        Height="20"
                        Canvas.Left="335"
                        Fill="white"
                        Canvas.Top="335" />

                    <Canvas Name="cnBr1" Canvas.Left="180" Canvas.Top="180">
                        <Canvas Name="cn1" Canvas.Left="0" Canvas.Top="0">
                        </Canvas>
                        <Ellipse x:Name="el11" HorizontalAlignment="Center" Height="650"  Stroke="Black" VerticalAlignment="Center" Width="650" Canvas.Left="0" Canvas.Top="0" RenderTransformOrigin="0,0">
                            <Ellipse.RenderTransform>
                                <TransformGroup>
                                    <!--<ScaleTransform/>
                                    <SkewTransform />-->
                                    <RotateTransform x:Name="rtAngel11" Angle="0"/>
                                    <TranslateTransform x:Name="tt11" X="-325" Y="-325"/>
                                </TransformGroup>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Canvas>

                    <!--<Button Content="Setting" Name="D1" Click="D_Click"  Canvas.Left="5" Canvas.Top="225" ></Button>-->
                    <Border Cursor="Hand" Panel.ZIndex="1000" Width="42" Height="24" Name="D1" MouseDown="D_Click" Canvas.Left="5" Canvas.Top="335" Background="#305371" Grid.Column="5" Grid.Row="0" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="5">
                        <Label Foreground="White" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Setting" ></Label>
                    </Border>
                </Canvas>
            </Border>

            <Grid Grid.Column="5" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="1.5*"/>
                    <RowDefinition Height="1.5*"/>
                    <RowDefinition Height=".1*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>


                <Grid Grid.Column="0" Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Border Cursor="Hand" HorizontalAlignment="Center" Width="150" Height="40" Margin="4" Background="Brown" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="10">
                        <Label Foreground="White" FontSize="16" Name="lblTCount2" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Total Count - 0" ></Label>
                    </Border>
                    <Border Cursor="Hand" HorizontalAlignment="Center" Width="150" Height="40" Margin="4" Background="Green" Grid.Column="0" Grid.Row="1" BorderBrush="Green" BorderThickness="1" CornerRadius="10">
                        <Label Foreground="White" FontSize="16" Name="lblOkCount2" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Content="OK Count - 0" ></Label>
                    </Border>
                    <Border Cursor="Hand" HorizontalAlignment="Center" Width="150" Height="40" Margin="4" Background="Red" Grid.Column="1" Grid.Row="1" BorderBrush="Red" BorderThickness="1" CornerRadius="10">
                        <Label Foreground="White" FontSize="16" Name="lblNotOkCount2" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Not Ok Count - 0" ></Label>
                    </Border>
                </Grid>

                <Grid Grid.Column="0" Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height=".5*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Border Cursor="Hand" Width="150" Height="70" Name="btnResetCounter2" MouseDown="btnResetCounter_Click" Margin="8" Background="#305371" Grid.Column="0" Grid.Row="0" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="10">
                        <Label Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Reset Count" ></Label>
                    </Border>

                    <Border Width="150" Height="70" Name="btnOverallResult2" Margin="2" Background="LightBlue" Grid.Column="1" Grid.Row="0" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="10">
                        <Label Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Overall Result" ></Label>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

    </Grid>
</Window>
