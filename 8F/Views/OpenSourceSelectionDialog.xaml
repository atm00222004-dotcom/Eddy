<Window x:Class="_8F.OpenSourceSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Open Configuration Source" Height="260" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" Background="Transparent" AllowsTransparency="True">

    <Window.Resources>
        <Style x:Key="MagkraftOptionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#305371"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="BorderBrush" Value="#FF000000"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1E3A8A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MagkraftCancelButtonStyle" TargetType="Button" BasedOn="{StaticResource MagkraftOptionButtonStyle}">
            <Setter Property="Background" Value="#64748B"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Border Margin="4" Background="#DBDBDB" BorderBrush="#B0B0B0" BorderThickness="1" CornerRadius="16" MouseDown="Window_MouseDown">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header Title -->
            <Label Grid.Row="0" Content="Open Configuration" FontSize="18" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center"/>

            <Separator Grid.Row="1" Margin="0,4,0,12" Background="#A0A0A0"/>

            <!-- Instruction -->
            <TextBlock Grid.Row="2" Text="Select how you would like to open the configuration:" Foreground="#334155" FontSize="13" FontWeight="SemiBold" Margin="4,0,4,12" TextWrapping="Wrap" HorizontalAlignment="Center"/>

            <!-- Option Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                <Button Name="btnFile" Style="{StaticResource MagkraftOptionButtonStyle}" Content="📁 Open from File" Width="180" Height="45" Margin="6,0" Click="btnFile_Click"/>
                <Button Name="btnDatabase" Style="{StaticResource MagkraftOptionButtonStyle}" Content="🗄️ Open from Database" Width="180" Height="45" Margin="6,0" Click="btnDatabase_Click"/>
            </StackPanel>

            <!-- Cancel Button -->
            <Button Grid.Row="4" Name="btnCancel" Style="{StaticResource MagkraftCancelButtonStyle}" Content="Cancel" Width="100" Height="34" HorizontalAlignment="Right" Click="btnCancel_Click"/>
        </Grid>
    </Border>
</Window>
