            </Grid.ColumnDefinitions>

            <Border Cursor="Hand" x:Name="br1" Margin="2,2,2,2" Grid.Row="0" Grid.Column="0" BorderThickness="2" >
                <Canvas  x:Name="Canvas1" HorizontalAlignment="Left" Margin="0" VerticalAlignment="Top">
                    <Rectangle Width="248" Fill="White"
                        Height="250"
                        Canvas.Left="0"
                        Canvas.Top="0" />

                    <TextBlock Name="lblFreq1" > 
                       
                    </TextBlock>

                    <TextBlock HorizontalAlignment="Right" Canvas.Left="185" Name="lblGraphXY1" > 
                       
                    </TextBlock>

                    <Rectangle Width="248"
                        Height=".5"
                        Canvas.Left="0"
                               Fill="Black"
                        Canvas.Top="125" />

                    <Rectangle Width=".5"
                        Height="250"
                        Canvas.Left="124"
                        Fill="Black"
                        Canvas.Top="0" />

                    <Rectangle Width="20" Name="rResult1"
                        Height="20"
                        Canvas.Left="225"
                        Fill="white"
                        Canvas.Top="227" />

                    <Canvas Name="cnBr1" Canvas.Left="122" Canvas.Top="123">
                        <Ellipse x:Name="el1" HorizontalAlignment="Center" Height="70"  Stroke="Black" VerticalAlignment="Center" Width="50" Canvas.Left="0" Canvas.Top="0" RenderTransformOrigin="0,0">
                            <Ellipse.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform/>
                                    <SkewTransform/>
                                    <RotateTransform x:Name="rtAngel1" Angle="0"/>
                                    <TranslateTransform x:Name="tt1" X="-23" Y="-33"/>
                                </TransformGroup>
                            </Ellipse.RenderTransform>
                        </Ellipse>

                        <!--<Ellipse Width="4"
                            Height="4"
                            Canvas.Left="10"
                            Canvas.Top="20"
                             Fill="Green">  
                        </Ellipse>

                        <Ellipse Width="4"
                            Height="4"
                            Canvas.Left="-30"
                            Canvas.Top="-40"
                             Fill="Red">        
                        </Ellipse>
                        
                        <Ellipse Width="4"
                            Height="4"
                            Canvas.Left="0"
                            Canvas.Top="0"
                             Fill="Blue">       
                        </Ellipse>-->
                        
                    </Canvas>

                    <Button Content="Setting" Name="D1" Click="D_Click"  Canvas.Left="5" Canvas.Top="225" ></Button>

