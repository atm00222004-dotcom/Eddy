<Window x:Class="_8F.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_8F"
        mc:Ignorable="d"
        Title="8F" 
        WindowState="Maximized" ResizeMode="NoResize"
        >

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height=".5*"/>
            <RowDefinition Height="7*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Menu VerticalAlignment="Stretch" FontSize="16" Grid.Row="0" Grid.Column="0" DockPanel.Dock="Top" ItemsSource="{Binding MenuItems}">
            <Menu.ItemContainerStyle>
                <Style TargetType="{x:Type MenuItem}">
                    <Setter Property="Command" Value="{Binding Command}" />
                </Style>
            </Menu.ItemContainerStyle>
            <Menu.ItemTemplate>
                <HierarchicalDataTemplate DataType="{x:Type local:MenuItemViewModel}" ItemsSource="{Binding Path=MenuItems}">
                    <TextBlock Text="{Binding Header}"/>
                </HierarchicalDataTemplate>
            </Menu.ItemTemplate>
        </Menu>

        <Grid Grid.Column="0" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border Cursor="Hand" x:Name="br1" Margin="2,10,2,10" Grid.Row="0" Grid.Column="0" BorderBrush="SlateGray"  BorderThickness="2" >
                <Canvas x:Name="Canvas1" HorizontalAlignment="Left" Margin="0" VerticalAlignment="Top">
                    <TextBlock Name="txtELbr1" > 
                        D1-100Hz,10dBP,10dB
                    </TextBlock>

                    <TextBlock HorizontalAlignment="Right" Canvas.Left="185" Name="txtRbr1" > 
                            x:100,y:100
                    </TextBlock> 
                    
                    <Rectangle Width="248"
                        Height="250"
                        Canvas.Left="0"
                        Canvas.Top="0" />                   

                    <Rectangle Width="248"
                        Height=".5"
                        Canvas.Left="0"
                               Fill="Black"
                        Canvas.Top="125" />

                    <Rectangle Width=".5"
                        Height="250"
                        Canvas.Left="124"
                        Fill="Black"
                        Canvas.Top="0" />

                    <Rectangle Width="10" Name="rResult"
                        Height="10"
                        Canvas.Left="235"
                        Fill="Green"
                        Canvas.Top="237" />       

                    <Canvas Name="cnBr1" Canvas.Left="122" Canvas.Top="123">
                        <Ellipse Width="4"
                            Height="4"
                            Canvas.Left="0"
                            Canvas.Top="0"
                             Fill="Blue">
                        </Ellipse>

                        <Ellipse x:Name="br1ellipse" HorizontalAlignment="Center" Height="70"  Stroke="Black" VerticalAlignment="Center" Width="50" Canvas.Left="0" Canvas.Top="0" RenderTransformOrigin="0,0">
                            <Ellipse.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform/>
                                    <SkewTransform/>
                                    <RotateTransform x:Name="rtAngel1" Angle="0"/>
                                    <TranslateTransform x:Name="tt1" X="-23" Y="-33"/>
                                </TransformGroup>
                            </Ellipse.RenderTransform>
                        </Ellipse>

                    </Canvas>
                </Canvas>
            </Border>

            <Border Cursor="Hand" x:Name="br2" Margin="2,10,2,10" Grid.Row="0" Grid.Column="1" BorderBrush="SlateGray"  BorderThickness="2" >
                <Canvas x:Name="Canvas2" HorizontalAlignment="Left" Margin="0" VerticalAlignment="Top">
                    <Ellipse x:Name="ellipse2" HorizontalAlignment="Center" Height="100"  Stroke="Black" VerticalAlignment="Center" Width="100" Canvas.Left="0" Canvas.Top="0" RenderTransformOrigin="0,0">
                        <Ellipse.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform x:Name="rtAngel2" Angle="0"/>
                                <TranslateTransform x:Name="tt2" X="0" Y="0"/>
                            </TransformGroup>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Canvas>
            </Border>

            <Border Cursor="Hand" x:Name="br3" Margin="2,10,2,10" Grid.Row="0" Grid.Column="2" BorderBrush="SlateGray"  BorderThickness="2" >
                <Canvas x:Name="Canvas3" HorizontalAlignment="Left" Margin="0" VerticalAlignment="Top">
                    <Ellipse x:Name="ellipse3" HorizontalAlignment="Center" Height="100"  Stroke="Black" VerticalAlignment="Center" Width="100" Canvas.Left="0" Canvas.Top="0" RenderTransformOrigin="0,0">
                        <Ellipse.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform x:Name="rtAngel3" Angle="0"/>
                                <TranslateTransform x:Name="tt3" X="0" Y="0"/>
                            </TransformGroup>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Canvas>
            </Border>

            <Border Cursor="Hand" x:Name="br4" Margin="2,10,2,10" Grid.Row="0" Grid.Column="3" BorderBrush="SlateGray"  BorderThickness="2" >
                <Canvas x:Name="Canvas4" HorizontalAlignment="Left" Margin="0" VerticalAlignment="Top">
                    <Ellipse x:Name="ellipse4" HorizontalAlignment="Center" Height="100"  Stroke="Black" VerticalAlignment="Center" Width="100" Canvas.Left="0" Canvas.Top="0" RenderTransformOrigin="0,0">
                        <Ellipse.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform x:Name="rtAngel4" Angle="0"/>
                                <TranslateTransform x:Name="tt4" X="0" Y="0"/>
                            </TransformGroup>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Canvas>
            </Border>

            <Border Cursor="Hand"  x:Name="br5" Margin="2,10,2,10" Grid.Row="1" Grid.Column="0" BorderBrush="SlateGray"  BorderThickness="2" >
                <Canvas x:Name="Canvas5" HorizontalAlignment="Left" Margin="0" VerticalAlignment="Top">
                    <Ellipse x:Name="ellipse5" HorizontalAlignment="Center" Height="100"  Stroke="Black" VerticalAlignment="Center" Width="100" Canvas.Left="0" Canvas.Top="0" RenderTransformOrigin="0,0">
                        <Ellipse.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform x:Name="rtAngel5" Angle="0"/>
                                <TranslateTransform x:Name="tt5" X="0" Y="0"/>
                            </TransformGroup>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Canvas>
            </Border>

            <Border Cursor="Hand" x:Name="br6" Margin="2,10,2,10" Grid.Row="1" Grid.Column="1" BorderBrush="SlateGray"  BorderThickness="2" >
                <Canvas x:Name="Canvas6" HorizontalAlignment="Left" Margin="0" VerticalAlignment="Top">
                    <Ellipse x:Name="ellipse6" HorizontalAlignment="Center" Height="100"  Stroke="Black" VerticalAlignment="Center" Width="100" Canvas.Left="0" Canvas.Top="0" RenderTransformOrigin="0,0">
                        <Ellipse.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform x:Name="rtAngel6" Angle="0"/>
                                <TranslateTransform x:Name="tt6" X="0" Y="0"/>
                            </TransformGroup>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Canvas>
            </Border>

            <Border Cursor="Hand"  x:Name="br7" Margin="2,10,2,10" Grid.Row="1" Grid.Column="2" BorderBrush="SlateGray"  BorderThickness="2" >
                <Canvas x:Name="Canvas7" HorizontalAlignment="Left" Margin="0" VerticalAlignment="Top">
                    <Ellipse x:Name="ellipse7" HorizontalAlignment="Center" Height="100"  Stroke="Black" VerticalAlignment="Center" Width="100" Canvas.Left="0" Canvas.Top="0" RenderTransformOrigin="0,0">
                        <Ellipse.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform x:Name="rtAngel7" Angle="0"/>
                                <TranslateTransform x:Name="tt7" X="0" Y="0"/>
                            </TransformGroup>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Canvas>
            </Border>

            <Border Cursor="Hand" x:Name="br8" Margin="2,10,2,10" Grid.Row="1" Grid.Column="3" BorderBrush="SlateGray"  BorderThickness="2" >
                <Canvas x:Name="Canvas8" HorizontalAlignment="Left" Margin="0" VerticalAlignment="Top">
                    <Ellipse x:Name="ellipse8" HorizontalAlignment="Center" Height="100"  Stroke="Black" VerticalAlignment="Center" Width="100" Canvas.Left="0" Canvas.Top="0" RenderTransformOrigin="0,0">
                        <Ellipse.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform x:Name="rtAngel8" Angle="0"/>
                                <TranslateTransform x:Name="tt8" X="0" Y="0"/>
                            </TransformGroup>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Canvas>
            </Border>

        </Grid>

        <Grid Grid.Column="0" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Button Content="Balance" Grid.Column="0" Grid.Row="0" />
            <Button Content="Test" Grid.Column="1" Grid.Row="0" />
            <Button Content="Clear" Grid.Column="2" Grid.Row="0" />
            <Button Content="Counter" Grid.Column="3" Grid.Row="0" />
            <Button Content="Reset Counter" Grid.Column="4" Grid.Row="0" />


        </Grid>

    </Grid>
</Window>
