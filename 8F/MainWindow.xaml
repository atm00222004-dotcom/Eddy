<Window x:Class="_8F.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_8F"
        mc:Ignorable="d"
        Title="8F" 
        WindowStyle="None" 
        WindowState="Maximized" ResizeMode="NoResize" Closed="Window_Closed"
        >

    <Grid Background="Black" Margin="2">
        <Grid.RowDefinitions>
            <RowDefinition Name="menuHeight" Height=".5*"/>
            <!--change it from backend-->
            <RowDefinition Name="chennelHeight" Height=".7*"/>
            <!--change it from backend-->
            <RowDefinition Height="7*"/>
            <RowDefinition Name="buttonBarHeight" Height="0*"/>
            <!--change it from backend-->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid Background="SaddleBrown"   Grid.Row="0" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="9*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Menu Background="SaddleBrown"  VerticalAlignment="Center" Height="50" FontSize="28" Grid.Row="0" Grid.Column="0" DockPanel.Dock="Top" ItemsSource="{Binding MenuItems}">
                <Menu.ItemContainerStyle>
                    <Style TargetType="{x:Type MenuItem}">
                        <Setter Property="Command" Value="{Binding Command}" />
                    </Style>
                </Menu.ItemContainerStyle>
                <Menu.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type local:MenuItemViewModel}" ItemsSource="{Binding Path=MenuItems}">
                        <TextBlock Text="{Binding Header}"/>
                    </HierarchicalDataTemplate>
                </Menu.ItemTemplate>
            </Menu>

            <Image Name="imgLogo"  Width="180" Panel.ZIndex="999" Grid.Row="0" Grid.Column="1" />

        </Grid>
       

        <Grid Grid.Column="0" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Button FontSize="18" FontWeight="Bold" Cursor="Hand" Background="DarkGray" Name="btnCh1" Tag="1" Click="btnCh_Click" Content="Channel-1" Grid.Column="0" Grid.Row="0" />
                <Button FontSize="18" FontWeight="Bold" Cursor="Hand" Background="DarkGray" Name="btnCh2" Tag="2" Content="Channel-2" Click="btnCh_Click" Grid.Column="1" Grid.Row="0" />
                <Button FontSize="18" FontWeight="Bold" Cursor="Hand" Background="DarkGray" Name="btnCh3" Tag="3" Content="Channel-3" Click="btnCh_Click" Grid.Column="2" Grid.Row="0" />
                <Button FontSize="18" FontWeight="Bold" Cursor="Hand" Background="DarkGray" Name="btnCh4"  Tag="4" Content="Channel-4" Click="btnCh_Click" Grid.Column="3" Grid.Row="0" />
            </Grid>
            <Grid Grid.Column="1" Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4.5*"/>
                    <ColumnDefinition  Width="4.5*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Label Name="lblPartLogs" Foreground="White" Content="" HorizontalAlignment="left" FontSize="12" FontWeight="Bold" Grid.Row="0" Grid.Column="0"></Label>
                <Label Name="lblConfigFileName" Foreground="White" Content="" HorizontalAlignment="Left" FontSize="12" FontWeight="Bold" Grid.Row="0" Grid.Column="1"></Label>
                <Border Panel.ZIndex="1000"  Name="brStatus" Margin="5"  Background="#305371" Grid.Column="2" Grid.Row="0" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="3">
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Column="0" Grid.Row="2">
