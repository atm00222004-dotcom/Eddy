                    <Label Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Balance" ></Label>
                </Border>

                <Border Cursor="Hand" Width="150" Height="70" Name="btnTest1" MouseDown="btnTest_Click" Margin="8" Background="#305371" Grid.Column="0" Grid.Row="1" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="10">
