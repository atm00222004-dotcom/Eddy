<Window x:Class="_8F.OperatorMaster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Operator Master"
        Height="550"
        Width="850"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize">

    <Border Margin="3"
            Background="#DBDBDB"
            BorderBrush="#DBDBDB"
            BorderThickness="1"
            CornerRadius="20">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="0.12*"/>
                <RowDefinition Height="0.04*"/>
                <RowDefinition Height="0.16*"/>
                <RowDefinition Height="0.04*"/>
                <RowDefinition Height="0.8*"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0">

                <Label Content="Operator Master"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

                <Border Width="90"
                        Height="40"
                        Margin="0,15,25,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="#305371"
                        BorderBrush="Black"
                        BorderThickness="1"
                        CornerRadius="10"
                        MouseDown="btnClose_MouseDown">

                    <Label Content="Close"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                </Border>

            </Grid>

            <Separator Grid.Row="1"/>

            <!-- INPUT -->
            <!-- Input Section -->
            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="2.5*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0"
           Margin="20,0,0,0"
           Content="Operator Name"
           FontSize="18"
           FontWeight="Bold"
           VerticalAlignment="Center"/>

                <TextBox x:Name="txtOperatorName"
             Grid.Column="1"
             Height="40"
             FontSize="18"
             VerticalContentAlignment="Center"
             Margin="5"
             TextChanged="txtOperatorName_TextChanged"/>

                <!-- SINGLE ADD / SAVE BUTTON -->
                <Border Grid.Column="2"
            Width="120"
            Height="45"
            Background="#305371"
            CornerRadius="10"
            Margin="5"
            MouseDown="btnAddSave_MouseDown">

                    <Label x:Name="lblAddSave"
               Content="Add"
               Foreground="White"
               FontSize="18"
               FontWeight="Bold"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>
                </Border>

            </Grid>

            <Separator Grid.Row="3"/>

            <!-- GRID AREA -->
            <Border Grid.Row="4"
                    Margin="5"
                    Background="#1F1F1F"
                    BorderBrush="Black"
                    BorderThickness="1"
                    CornerRadius="10">

                <Grid>

                    <!-- EMPTY MESSAGE -->
                    <TextBlock x:Name="txtOperatorMessage"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"
                               Text="No operators available"/>

                    <!-- DATA GRID -->
                    <DataGrid x:Name="grdOperator"
                              Margin="2"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              FontSize="18"
                              SelectionMode="Single"
                              SelectionChanged="grdOperator_SelectionChanged">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Operator Name"
                                                Binding="{Binding OperatorName}"
                                                Width="*" />

                            <DataGridTemplateColumn Header="Actions" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">

                                            <Button Content="Edit"
                                                    Width="70"
                                                    Margin="2"
                                                    Click="Edit_Click"/>

                                            <Button Content="Delete"
                                                    Width="70"
                                                    Margin="2"
                                                    Click="Delete_Click"/>

                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

        </Grid>

    </Border>
</Window>