<Window x:Class="_8F.PartFamilyMaster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Part Family Master"
        Height="650"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize">

    <Border Margin="3"
            Background="#DBDBDB"
            BorderBrush="#DBDBDB"
            BorderThickness="1"
            CornerRadius="20">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0">

                <Label Content="Part Family Master"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

                <Border Width="90"
                        Height="40"
                        Margin="0,15,25,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="#305371"
                        BorderBrush="Black"
                        BorderThickness="1"
                        CornerRadius="10"
                        MouseDown="btnClose_MouseDown">

                    <Label Content="Close"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                </Border>

            </Grid>

            <Separator Grid.Row="1"/>

            <!-- MAIN AREA -->
            <Grid Grid.Row="2" Margin="10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===================== -->
                <!-- FAMILY SECTION -->
                <!-- ===================== -->
                <Border Grid.Column="0"
                        Background="#ECECEC"
                        BorderBrush="Black"
                        BorderThickness="1"
                        CornerRadius="15">

                    <Grid Margin="10">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="60"/>
                            <RowDefinition Height="70"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Label Content="Part Families"
                               FontSize="22"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                        <!-- INPUT AREA -->
                        <Grid Grid.Row="1">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <Label Grid.Column="0"
                               Content="Family Name"
                               FontSize="16"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>

                            <TextBox x:Name="txtFamilyName"
                             TextChanged="txtFamilyName_TextChanged"
                             Grid.Column="1"
                             Height="40"
                             FontSize="16"
                             VerticalContentAlignment="Center"
                             Margin="5"/>

                            <Button x:Name="btnFamilyAddSave"
                            Grid.Column="2"
                            Margin="5"
                            Content="Add"
                            Click="btnFamilyAddSave_Click"/>
                        </Grid>

                        <!-- GRID -->
                        <Border Grid.Row="2"
        Background="#1F1F1F"
        CornerRadius="10"
        Margin="0,10,0,0">

                            <Grid>

                                <!-- EMPTY STATE -->
                                <TextBlock x:Name="txtFamiliesMessage"
                   Foreground="White"
                   FontSize="18"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"
                   Text="No families available"/>

                                <!-- DATA GRID -->
                                <DataGrid x:Name="grdFamilies"
                  Margin="2"
                  FontSize="16"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  SelectionChanged="grdFamilies_SelectionChanged">

                                    <DataGrid.Columns>

                                        <DataGridTextColumn Header="Family Name"
                                    Binding="{Binding FamilyName}"
                                    Width="*" />

                                        <DataGridTemplateColumn Header="Actions" Width="180">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">

                                                        <Button Content="Edit"
                                        Width="70"
                                        Margin="2"
                                        Click="grdFamilies_Edit_Click"/>

                                                        <Button Content="Delete"
                                        Width="70"
                                        Margin="2"
                                        Click="grdFamilies_Delete_Click"/>

                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                    </DataGrid.Columns>

                                </DataGrid>

                            </Grid>

                        </Border>

                    </Grid>

                </Border>

                <!-- ===================== -->
                <!-- PART SECTION -->
                <!-- ===================== -->
                <Border Grid.Column="2"
                        Background="#ECECEC"
                        BorderBrush="Black"
                        BorderThickness="1"
                        CornerRadius="15">

                    <Grid Margin="10">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="60"/>
                            <RowDefinition Height="70"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Label Content="Parts"
                               FontSize="22"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                        <!-- INPUT AREA -->
                        <Grid Grid.Row="1">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <Label Grid.Column="0"
           Content="Part Number"
           FontSize="16"
           FontWeight="Bold"
           VerticalAlignment="Center"/>

                            <TextBox x:Name="txtPartNumber"
                            TextChanged="txtPartNumber_TextChanged"

             Grid.Column="1"
             Height="40"
             FontSize="16"
             VerticalContentAlignment="Center"
             Margin="5"/>

                            <Button x:Name="btnPartAddSave"
            Grid.Column="2"
            Margin="5"
            Content="Add"
            Click="btnPartAddSave_Click"/>

                        </Grid>

                        <!-- GRID -->
                        <Border Grid.Row="2"
        Background="#1F1F1F"
        CornerRadius="10"
        Margin="0,10,0,0">

                            <Grid>

                                <!-- EMPTY STATE MESSAGE -->
                                <TextBlock x:Name="txtPartsMessage"
           Foreground="White"
           FontSize="18"
           FontWeight="Bold"
           HorizontalAlignment="Center"
           VerticalAlignment="Center"
           Visibility="Visible"
           Text=""/>

                                <!-- DATA GRID -->
                                <DataGrid x:Name="grdParts"
                  Margin="2"
                  FontSize="16"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  SelectionChanged="grdParts_SelectionChanged">

                                    <DataGrid.Columns>

                                        <DataGridTextColumn Header="Part Number"
                                    Binding="{Binding PartNumber}"
                                    Width="*" />

                                        <DataGridTemplateColumn Header="Actions" Width="180">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">

                                                        <Button Content="Edit"
                                        Width="70"
                                        Margin="2"
                                        Click="grdParts_Edit_Click"/>

                                                        <Button Content="Delete"
                                        Width="70"
                                        Margin="2"
                                        Click="grdParts_Delete_Click"/>

                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                    </DataGrid.Columns>

                                </DataGrid>

                            </Grid>

                        </Border>

                    </Grid>

                </Border>

            </Grid>

        </Grid>

    </Border>

</Window>