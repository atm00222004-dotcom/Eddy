<Window x:Class="_8F.AutoEllipse"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Auto Ellipse Calibration" Height="620" Width="1080"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F8FAFC">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- Controls Bar -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Label Content="Channel:" Foreground="#0F172A" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Grid.Column="0"/>
                <ComboBox Name="cboChannel" Grid.Column="1" Height="28" FontSize="13" SelectionChanged="cboChannel_SelectionChanged"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Name="btnSelectAll" Content="Select All" Width="90" Height="28" FontSize="12" FontWeight="SemiBold" 
                            Background="#475569" Foreground="White" Click="btnSelectAll_Click" Margin="0,0,8,0" Cursor="Hand"/>
                    <Button Name="btnDeselectAll" Content="Deselect All" Width="95" Height="28" FontSize="12" FontWeight="SemiBold" 
                            Background="#64748B" Foreground="White" Click="btnDeselectAll_Click" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Captured Multi-Frequency Test Runs Table -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Captured Multi-Frequency Test Runs Table" Foreground="#0F172A" FontSize="13" FontWeight="Bold" Margin="4,2,0,4"/>

                <DataGrid Name="dgTestResults" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                          Background="#FFFFFF" RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC"
                          Foreground="#0F172A" GridLinesVisibility="All" HorizontalGridLinesBrush="#E2E8F0" VerticalGridLinesBrush="#E2E8F0"
                          HeadersVisibility="Column" FontSize="12" ColumnHeaderHeight="28" RowHeight="26"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#305371"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="4,2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="3,2"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.Resources>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="#E2E8F0" CornerRadius="4" Padding="6,4" Margin="0,0,0,8">
            <TextBlock Name="lblStatus" Text="Ready for Auto Ellipse calibration." Foreground="#1E293B" FontSize="12" FontWeight="Medium"/>
        </Border>

        <!-- Action Buttons Bar -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Name="btnRunTest" Content="Run Test" Width="120" Height="36" FontSize="13" FontWeight="Bold" 
                        Background="#305371" Foreground="White" Click="btnRunTest_Click" Margin="0,0,8,0" Cursor="Hand"/>
                <Button Name="btnStopTest" Content="Stop Test" Width="100" Height="36" FontSize="13" FontWeight="Bold" 
                        Background="#DC2626" Foreground="White" Click="btnStopTest_Click" IsEnabled="False" Margin="0,0,8,0" Cursor="Hand"/>
                <Button Name="btnMakeEllipse" Content="Make Ellipse" Width="140" Height="36" FontSize="13" FontWeight="Bold" 
                        Background="#305371" Foreground="White" Click="btnMakeEllipse_Click" IsEnabled="False" Margin="0,0,8,0" Cursor="Hand"/>
            </StackPanel>

            <Button Name="btnClose" Grid.Column="1" Content="Close" Width="90" Height="36" FontSize="13" FontWeight="Bold" 
                    Background="#64748B" Foreground="White" Click="btnClose_Click" Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>
