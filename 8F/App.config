<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<appSettings>
		<!--Ellipse default data-->
		<add key="Factor" value="1" />
		<add key="Height" value="120" />
		<add key="Width" value="120" />
		<add key="Height_O" value="650" />
		<add key="Width_O" value="650" />
		<add key="Angel_O" value="30" />
		<add key="AppMode" value="0" />
		<add key="Mode" value="1" />
		<add key="MinFreq" value="50" />

		<!-- Channel 1-4 -->
		<add key="Channel" value="1" />

		<!-- Frequency No 1,4,8 -->
		<add key="FrequencyNo" value="8" />

		<!--CommunicationType = 0 ==> Communication through COM POrt  and CommunicationType = 1 ==> Communication through Ethernet-->
		<add key="CommunicationType" value="0" />
		<!--CommunicationType = 0 ==> Communication through COM POrt -->
		<add key="PortName" value="COM5" />
		<add key="BaudRate" value="115200" />
		<add key="CodePortName" value="NONE" />
		<!--CommunicationType = 1 ==> Communication through Ethernet-->
		<add key="IP" value="192.168.1.2" />
		<add key="Port" value="7890" />

		<!--Screen resolution Id (1=> 1920x1080, 2=> 1280x800, 3=> 1366x768,   4=> 1024x768)-->
		<add key="ScreenId" value="4" />

		<add key="BoxSize1" value="300" />
		
		<add key="BoxSize2" value="312" />
		<add key="BoxSize3" value="300" />

		<!--FrequencyNo =1 && BoxSize4=670, FrequencyNo =4 && BoxSize4=330, FrequencyNo =8 && BoxSize4=250 -->
		<add key="BoxSize4" value="250" />

		<add key="LogoPath" value="E:\\Projects\\Eddy\\8F\\IMPAC.png" />
		<add key="WebPage" value="http://localhost:3000/Eddy" />

		<add key="LogEnable" value="true" />
		<add key="ConnectionString" value="Host=localhost;Port=5432;Username=postgres;Password=aryan123;Database=EddyShorter" />

		<add key="SerialNumber" value="A1234567890B" />

		<add key="CodeReadGapInMS" value="100" />

		<add key="CSVPath" value="E:\Data\" />
		
		<add key="IsJSON" value="false" />
		
		<!-- ============================================================ -->
		<!-- FILE MENU TOGGLES (File -> New, Open, Save, Import, Export, Exit) -->
		<!-- ============================================================ -->
		<add key="isOpenDbEbable" value="true" />              <!-- Open Profile from Database -->
		<add key="IsSaveEnable" value="true" />                <!-- Save Profile to Database -->
		<add key="IsSaveAsEnable" value="true" />              <!-- Save As Profile to Database -->
		<add key="isOpenEnable" value="true" />                <!-- Import Configuration File -->
		<add key="IsExportConfigurationEnable" value="true" /> <!-- Export Configuration Profile -->
		<add key="IsExitEnable" value="true" />                <!-- Exit Application -->

		<!-- ============================================================ -->
		<!-- CONFIGURATION MENU TOGGLES (Configuration -> Change, Threshold, Auto Ellipse, Masters, Write) -->
		<!-- ============================================================ -->
		<add key="IsChangeConfigurationEnable" value="true" /> <!-- Change Configuration (Frequency Settings) -->
		<add key="IsThresholdSettingEnable" value="true" />    <!-- Threshold Setting (Circle & Ellipse Settings) -->
		<add key="IsAutoEllipseEnable" value="true" />         <!-- Auto Ellipse Calibration Window -->
		<add key="IsReNewConfig" value="true" />               <!-- Enable Operator Master & Part Master (Renew Mode) -->
		<add key="IsWriteConfigurationEnable" value="true" />  <!-- Write Configuration to Hardware Instrument -->
		<add key="IsCopyChannel1ConfigurationEnable" value="true" /> <!-- Copy Channel-1 Configuration -->
		<add key="IsChangePasswordEnable" value="true" />      <!-- Password Protection for Config Items -->

		<!-- ============================================================ -->
		<!-- VIEW LOG MENU TOGGLES (View Log -> Batch Wise Log, Serial Number Log) -->
		<!-- ============================================================ -->
		<add key="IsBatchWiseLogEnable" value="true" />       <!-- Batch Wise Log View -->
		<add key="IsSerialNumberLogEnable" value="true" />    <!-- Serial Number Log View (Standard Mode) -->
		<add key="IsPdfReportEnable" value="true" />          <!-- PDF Report Generation -->

		<!-- ============================================================ -->
		<!-- COUNTER & UI VISIBILITY TOGGLES (Main Window & Grid Counters) -->
		<!-- ============================================================ -->
		<add key="IsTotalCountVisible" value="true" />        <!-- Show/Hide Total Count Button & Grid Column -->
		<add key="IsOkCountVisible" value="true" />           <!-- Show/Hide OK Count Button & Grid Column -->
		<add key="IsNotOkCountVisible" value="true" />        <!-- Show/Hide Not OK Count Button & Grid Column -->

		<!-- ============================================================ -->
		<!-- SYSTEM HARDWARE & TENANT SETTINGS -->
		<!-- ============================================================ -->
		<add key="IsLogRequiredOnBalance" value="true" />
		<add key="IsTxStrengthEnable" value="true" />
		<add key="IsTestLogOff" value="true" />
		<add key="TenantName" value="Tenant 1" />
		<add key="Version" value="1" />
		<add key="SubVersion" value="0" />
		<add key="IsMachineValidationRequired" value="false" />
		
	</appSettings>
</configuration>