<Window x:Class="_8F.SaveProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save Profile to Database" Height="220" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" Background="Transparent" AllowsTransparency="True">

    <Window.Resources>
        <Style x:Key="MagkraftButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#305371"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#FF000000"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1E3A8A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MagkraftCancelButtonStyle" TargetType="Button" BasedOn="{StaticResource MagkraftButtonStyle}">
            <Setter Property="Background" Value="#64748B"/>
        </Style>
    </Window.Resources>

    <Border Margin="4" Background="#DBDBDB" BorderBrush="#B0B0B0" BorderThickness="1" CornerRadius="16" MouseDown="Border_MouseDown">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0" Text="Save Configuration Profile to Database" FontSize="18" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <!-- Input Controls -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <Label Content="Profile Name:" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"/>
                <TextBox Name="txtProfileName" FontSize="14" Height="32" Padding="6,4" FontWeight="SemiBold" Margin="0,4,0,0" KeyDown="txtProfileName_KeyDown"/>
            </StackPanel>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Name="btnSave" Content="Save" Width="100" Height="34" Style="{StaticResource MagkraftButtonStyle}" Click="btnSave_Click" Margin="0,0,10,0"/>
                <Button Name="btnCancel" Content="Cancel" Width="100" Height="34" Style="{StaticResource MagkraftCancelButtonStyle}" Click="btnCancel_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
